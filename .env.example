# Firebase (Frontend)
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:000000000000

# API Base URL (Cloud Functions)
VITE_API_BASE=http://127.0.0.1:5001/your-project-id/us-central1

# Cloud Functions Environment (set via firebase functions:config:set)
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SALES_EMAIL=sales@your-company.com
